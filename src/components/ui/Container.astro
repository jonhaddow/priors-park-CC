---
interface Props {
  class?: string;
  size?: "narrow" | "default" | "wide";
}

const { class: className = "", size = "default" } = Astro.props;

const widths = {
  narrow: "max-w-3xl",
  default: "max-w-6xl",
  wide: "max-w-7xl",
};
---

<div class={`mx-auto w-full px-5 sm:px-8 ${widths[size]} ${className}`}>
  <slot />
</div>
