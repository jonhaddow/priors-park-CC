---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  tone?: "light" | "deep";
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  align = "left",
  tone = "light",
  id,
  class: className = "",
} = Astro.props;

const alignment =
  align === "center" ? "items-center text-center" : "items-start text-left";
const titleColour = tone === "deep" ? "text-ink-inverse" : "text-ink";
const bodyColour =
  tone === "deep" ? "text-ink-inverse-muted" : "text-ink-muted";
---

<div class={`flex flex-col gap-4 ${alignment} ${className}`}>
  {
    eyebrow && <Eyebrow tone={tone}>{eyebrow}</Eyebrow>
  }
  <h2 id={id} class={`text-title font-semibold ${titleColour}`}>{title}</h2>
  {
    Astro.slots.has("default") && (
      <div class={`text-lead max-w-2xl ${bodyColour}`}>
        <slot />
      </div>
    )
  }
</div>
