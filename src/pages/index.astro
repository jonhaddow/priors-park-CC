---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../components/ContactSection.astro";
import Hero from "../components/Hero.astro";
import OurStory from "../components/OurStory.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import Sundays from "../components/Sundays.astro";
import WhatsOn from "../components/WhatsOn.astro";
import { getConfig } from "helpers/config";
import { getTeam } from "helpers/team";
import { getWhatsOnCards } from "helpers/whatson";

const config = await getConfig();
const cards = await getWhatsOnCards();
const team = await getTeam();
---

<BaseLayout>
  <Hero config={config} />
  <WhatsOn cards={cards} />
  <PhotoStrip photoGallery={config.photoGallery} />
  <Sundays text={config.sunday} config={config} />
  <OurStory
    mission={config.mission}
    network={config.network}
    team={team}
  />
  <ContactSection config={config} />
</BaseLayout>
