---
import BaseLayout from "layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import Icon from "../components/ui/Icon.astro";
import PageHeader from "../components/PageHeader.astro";

const calendarId = "dGhlaHVicHBjY0BnbWFpbC5jb20";
const calendarSrc = `https://calendar.google.com/calendar/embed?height=800&wkst=1&ctz=Europe%2FLondon&mode=AGENDA&hl=en_GB&showPrint=0&showTitle=0&showCalendars=0&src=${calendarId}&color=%23103e50`;
const calendarLink = `https://calendar.google.com/calendar/u/0/r?cid=${calendarId}`;
---

<BaseLayout
  title="Calendar"
  description="Everything happening at Priors Park Community Church, week by week."
>
  <PageHeader eyebrow="Week by week" title="Church calendar">
    Everything happening at the church, straight from our shared calendar.
  </PageHeader>

  <div class="bg-surface py-12 lg:py-16">
    <Container size="wide" class="flex flex-col gap-6">
      <div
        class="border-ink/8 shadow-card overflow-hidden rounded-panel border bg-white"
      >
        <iframe
          title="Priors Park Community Church calendar"
          src={calendarSrc}
          loading="lazy"
          class="block h-[70vh] min-h-[34rem] w-full border-0"></iframe>
      </div>

      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="text-ink-muted text-sm">
          Times can change at short notice — check our Facebook page for the
          latest.
        </p>
        <Button
          href={calendarLink}
          variant="secondary"
          target="_blank"
          rel="noreferrer noopener"
        >
          <Icon name="calendar" class="h-4 w-4" />
          Open in Google Calendar
          <Icon name="external" class="h-3.5 w-3.5" />
        </Button>
      </div>
    </Container>
  </div>
</BaseLayout>
